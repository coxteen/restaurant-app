<Window x:Class="RestaurantApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:RestaurantApp.Views"
        xmlns:local="clr-namespace:RestaurantApp"
        mc:Ignorable="d"
        Title="Restaurant App" 
        Height="1000" 
        Width="1300"
        WindowStartupLocation="CenterScreen"
        Background="#3A3A3A"
        x:Name="window">

    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#4A4A4A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5A5A5A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Admin Button Style -->
        <Style x:Key="AdminButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#2D4263"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3D5273"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1D3253"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cart Button Style -->
        <Style x:Key="CartButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#C84B31"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D85B41"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#B83B21"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Contact Button Style -->
        <Style x:Key="ContactButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#7E57C2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#8E67D2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#6E47B2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Auth Button Style -->
        <Style x:Key="AuthButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#2E8B57"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3E9B67"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1E7B47"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Navigation Button Style -->
        <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#191919"/>
            <Setter Property="Width" Value="110"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#292929"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#090909"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dialog Button Style -->
        <Style x:Key="DialogButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Background" Value="#4A4A4A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5A5A5A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Bar with App Title and User Info -->
        <Border Grid.Row="0" Background="#191919" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="🍽️" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="White"/>
                    <TextBlock Text="Restaurant App" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Foreground="White"/>
                </StackPanel>

                <!-- User Info -->
                <TextBlock Grid.Column="1" x:Name="userInfoText" Foreground="#EEEEEE" VerticalAlignment="Center" 
                           HorizontalAlignment="Center" FontSize="16" FontWeight="Medium"/>

                <!-- Auth Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <!-- Contact Button -->
                    <Button x:Name="btnContact" Click="ContactButton_Click" Style="{StaticResource ContactButtonStyle}" 
                            Margin="5,0,5,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📞" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Contact" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- About Me Button (NEW) -->
                    <Button x:Name="btnAboutMe" Click="AboutMeButton_Click" Style="{StaticResource ContactButtonStyle}" 
                            Margin="5,0,5,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="About Me" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Cart Button -->
                    <Button x:Name="btnCart" Click="CartButton_Click" Style="{StaticResource CartButtonStyle}" 
                            Margin="5,0,15,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛒" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Cart" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            <Border Background="#FFFFFF" CornerRadius="10" Margin="5,0,0,0" 
                                    Visibility="{Binding ShoppingCartItemCount, Converter={StaticResource IntToVisibilityConverter}}">
                                <TextBlock Text="{Binding ShoppingCartItemCount}" Foreground="#C84B31" Margin="5,0" FontSize="12" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnLogin" Content="Login" Click="LoginButton_Click" 
                            Style="{StaticResource AuthButtonStyle}"/>
                    <Button x:Name="btnLogout" Content="Logout" Click="LogoutButton_Click" 
                            Style="{StaticResource AuthButtonStyle}" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Navigation Panel -->
        <Border Grid.Row="1" Background="#2A2A2A" Padding="15,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Main Navigation -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="Menu" Style="{StaticResource NavButtonStyle}" Click="MenuButton_Click"/>
                    <Button Content="Search" Style="{StaticResource NavButtonStyle}" Click="SearchButton_Click"/>
                    <Button x:Name="btnOrders" Content="My Orders" Style="{StaticResource NavButtonStyle}" 
                           Click="OrdersButton_Click" Visibility="Collapsed"/>
                </StackPanel>

                <!-- Admin Panel -->
                <StackPanel Grid.Column="2" x:Name="adminPanel" Orientation="Horizontal" Visibility="Collapsed">
                    <Separator Background="#4A4A4A" Width="1" Margin="10,0"/>
                    <Button Content="Categories" Style="{StaticResource AdminButtonStyle}" Click="CategoriesButton_Click"/>
                    <Button Content="Products" Style="{StaticResource AdminButtonStyle}" Click="ProductsButton_Click"/>
                    <Button Content="All Orders" Style="{StaticResource AdminButtonStyle}" Click="AllOrdersButton_Click"/>
                    <Button Content="Stock Alert" Style="{StaticResource AdminButtonStyle}" Click="StockAlertButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content with Shadow Effect -->
        <Border Grid.Row="2" Background="#2A2A2A" Margin="15" CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="2" Opacity="0.3" BlurRadius="10"/>
            </Border.Effect>
            <ContentControl x:Name="MainContent" Margin="5"/>
        </Border>

        <!-- Contact Info Overlay -->
        <Border x:Name="contactOverlay" Background="#80000000" Visibility="Collapsed" Grid.RowSpan="3">
            <Border Width="500" Height="560" Background="#2A2A2A" CornerRadius="10" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Overlay Header -->
                    <Border Grid.Row="0" Background="#191919" CornerRadius="10,10,0,0" Padding="20,15">
                        <Grid>
                            <TextBlock Text="Contact Information" FontSize="22" Foreground="White" 
                                       FontWeight="Bold" HorizontalAlignment="Left"/>
                            <Button Content="✕" Click="CloseContactOverlay_Click" 
                                    HorizontalAlignment="Right" Width="30" Height="30"
                                    Background="Transparent" Foreground="White" 
                                    BorderThickness="0" FontSize="16" FontWeight="Bold"/>
                        </Grid>
                    </Border>

                    <!-- Contact Information -->
                    <StackPanel Grid.Row="1" Margin="25,20">
                        <!-- Restaurant Name -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,25">
                            <TextBlock Text="🏢" FontSize="22" VerticalAlignment="Center" Margin="0,0,15,0" Foreground="White"/>
                            <StackPanel>
                                <TextBlock Text="Delicious Restaurant" FontSize="20" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Fine Dining &amp; Takeout" FontSize="14" Foreground="#CCCCCC" Margin="0,5,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Phone -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <TextBlock Text="📱" FontSize="20" VerticalAlignment="Center" Margin="0,0,15,0" Foreground="White"/>
                            <StackPanel>
                                <TextBlock Text="Phone Number" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="+40 123 456 789" FontSize="14" Foreground="#CCCCCC" Margin="0,5,0,0"/>
                                <TextBlock Text="+40 987 654 321" FontSize="14" Foreground="#CCCCCC" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Address -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <TextBlock Text="📍" FontSize="20" VerticalAlignment="Center" Margin="0,0,15,0" Foreground="White"/>
                            <StackPanel>
                                <TextBlock Text="Address" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="123 Delicious Street" FontSize="14" Foreground="#CCCCCC" Margin="0,5,0,0"/>
                                <TextBlock Text="Gourmet City, Foodland" FontSize="14" Foreground="#CCCCCC" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Hours -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <TextBlock Text="🕒" FontSize="20" VerticalAlignment="Center" Margin="0,0,15,0" Foreground="White"/>
                            <StackPanel>
                                <TextBlock Text="Opening Hours" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Monday - Friday:" Foreground="#CCCCCC" FontSize="14"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="09:00 - 22:00" Foreground="#CCCCCC" FontSize="14"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Saturday:" Foreground="#CCCCCC" FontSize="14" Margin="0,2,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="10:00 - 23:00" Foreground="#CCCCCC" FontSize="14" Margin="0,2,0,0"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Sunday:" Foreground="#CCCCCC" FontSize="14" Margin="0,2,0,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="12:00 - 20:00" Foreground="#CCCCCC" FontSize="14" Margin="0,2,0,0"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <!-- Email -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✉️" FontSize="20" VerticalAlignment="Center" Margin="0,0,15,0" Foreground="White"/>
                            <StackPanel>
                                <TextBlock Text="Email" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="contact@deliciousrestaurant.com" FontSize="14" Foreground="#CCCCCC" Margin="0,5,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Close Button -->
                    <Button Grid.Row="2" Content="Close" Click="CloseContactOverlay_Click" 
                            Style="{StaticResource DialogButtonStyle}" 
                            HorizontalAlignment="Center" Margin="0,0,0,20"/>
                </Grid>
            </Border>
        </Border>

        <!-- About Me Overlay (NEW) -->
        <Border x:Name="aboutMeOverlay" Background="#80000000" Visibility="Collapsed" Grid.RowSpan="3">
            <Border Width="500" Height="410" Background="#2A2A2A" CornerRadius="10" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Overlay Header -->
                    <Border Grid.Row="0" Background="#191919" CornerRadius="10,10,0,0" Padding="20,15">
                        <Grid>
                            <TextBlock Text="About Me" FontSize="22" Foreground="White" 
                                       FontWeight="Bold" HorizontalAlignment="Left"/>
                            <Button Content="✕" Click="CloseAboutMeOverlay_Click" 
                                    HorizontalAlignment="Right" Width="30" Height="30"
                                    Background="Transparent" Foreground="White" 
                                    BorderThickness="0" FontSize="16" FontWeight="Bold"/>
                        </Grid>
                    </Border>

                    <!-- About Me Information -->
                    <StackPanel Grid.Row="1" Margin="25,20">
                        <!-- Profile Icon and Name -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,25">
                            <TextBlock Text="👤" FontSize="32" VerticalAlignment="Center" Margin="0,0,15,0" Foreground="White"/>
                            <StackPanel>
                                <TextBlock x:Name="studentNameText" Text="Your Name" FontSize="22" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Computer Science Student" FontSize="14" Foreground="#CCCCCC" Margin="0,5,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- University Information -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <TextBlock Text="🏫" FontSize="22" VerticalAlignment="Center" Margin="0,0,15,0" Foreground="White"/>
                            <StackPanel>
                                <TextBlock Text="University" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock x:Name="universityNameText" Text="Your University" FontSize="14" Foreground="#CCCCCC" Margin="0,5,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Study Year -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <TextBlock Text="📚" FontSize="22" VerticalAlignment="Center" Margin="0,0,15,0" Foreground="White"/>
                            <StackPanel>
                                <TextBlock Text="Study Year" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock x:Name="studyYearText" Text="Year X" FontSize="14" Foreground="#CCCCCC" Margin="0,5,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Group -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👥" FontSize="22" VerticalAlignment="Center" Margin="0,0,15,0" Foreground="White"/>
                            <StackPanel>
                                <TextBlock Text="Group" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock x:Name="groupText" Text="Group XXX" FontSize="14" Foreground="#CCCCCC" Margin="0,5,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Close Button -->
                    <Button Grid.Row="2" Content="Close" Click="CloseAboutMeOverlay_Click" 
                            Style="{StaticResource DialogButtonStyle}" 
                            HorizontalAlignment="Center" Margin="0,0,0,20"/>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>