<Window x:Class="RestaurantApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:RestaurantApp.Views"
        xmlns:local="clr-namespace:RestaurantApp"
        mc:Ignorable="d"
        Title="Restaurant App" Height="600" Width="900"
        x:Name="window">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- User Info Panel -->
        <DockPanel Grid.Row="0" Background="#333333">
            <Button x:Name="btnLogin" Content="Login" Click="LoginButton_Click" 
                    DockPanel.Dock="Right" Margin="5" Padding="10,5"/>
            <Button x:Name="btnLogout" Content="Logout" Click="LogoutButton_Click" 
                    DockPanel.Dock="Right" Margin="5" Padding="10,5" Visibility="Collapsed"/>
            <views:CartButtonControl DockPanel.Dock="Right" ItemCount="{Binding ElementName=window, Path=ShoppingCartItemCount}"
                                   CartClickCommand="{Binding ElementName=window, Path=CartClickCommand}"
                                   Margin="5,0,0,0"/>
            <TextBlock x:Name="userInfoText" Foreground="White" VerticalAlignment="Center" 
                      Margin="10,0,0,0" FontSize="14"/>
        </DockPanel>

        <!-- Navigation Panel -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Background="#F5F5F5">
            <Button Content="Menu" Margin="5" Padding="10,5" Click="MenuButton_Click"/>
            <Button Content="Search" Margin="5" Padding="10,5" Click="SearchButton_Click"/>
            <Button x:Name="btnOrders" Content="My Orders" Margin="5" Padding="10,5" 
                   Click="OrdersButton_Click" Visibility="Collapsed"/>

            <!-- Admin Panel -->
            <StackPanel x:Name="adminPanel" Orientation="Horizontal" Visibility="Collapsed">
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="5,0"/>
                <Button Content="Categories" Margin="5" Padding="10,5" Click="CategoriesButton_Click"/>
                <Button Content="Products" Margin="5" Padding="10,5" Click="ProductsButton_Click"/>
                <Button Content="All Orders" Margin="5" Padding="10,5" Click="AllOrdersButton_Click"/>
                <Button Content="Stock Alert" Margin="5" Padding="10,5" Click="StockAlertButton_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- Main Content -->
        <ContentControl Grid.Row="2" x:Name="MainContent"/>
    </Grid>
</Window>