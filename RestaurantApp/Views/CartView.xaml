<UserControl x:Class="RestaurantApp.Views.CartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Your Cart" FontSize="24" Margin="10" FontWeight="SemiBold"/>

        <!-- Cart Items -->
        <ListView Grid.Row="1" ItemsSource="{Binding Cart.Items}" Margin="10">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Product" DisplayMemberBinding="{Binding ProductName}" Width="200"/>
                    <GridViewColumn Header="Unit Price" DisplayMemberBinding="{Binding UnitPrice, StringFormat='{}{0:C}'}" Width="100"/>
                    <GridViewColumn Header="Quantity" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="-" Width="30" Height="24"
                                            Command="{Binding DataContext.UpdateQuantityCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding ProductId, Converter={StaticResource ProductQuantityConverter}, ConverterParameter=-1}"/>
                                    <TextBlock Text="{Binding Quantity}" Width="30" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <Button Content="+" Width="30" Height="24"
                                            Command="{Binding DataContext.UpdateQuantityCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding ProductId, Converter={StaticResource ProductQuantityConverter}, ConverterParameter=1}"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Total" DisplayMemberBinding="{Binding TotalPrice, StringFormat='{}{0:C}'}" Width="100"/>
                    <GridViewColumn Header="Actions" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Remove" 
                                        Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                        CommandParameter="{Binding ProductId}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <!-- Summary and Checkout -->
        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Message -->
                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{Binding Message}" 
                           Foreground="Green" Margin="0,0,0,10"
                           Visibility="{Binding Message, Converter={StaticResource StringToVisibilityConverter}}"/>

                <!-- Cart Empty Message -->
                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Your cart is empty" 
                           FontSize="16" HorizontalAlignment="Center" Margin="0,20"
                           Visibility="{Binding Cart.Items.Count, Converter={StaticResource ZeroToVisibilityConverter}}"/>

                <!-- Subtotal -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Subtotal:" HorizontalAlignment="Right"
                           Visibility="{Binding Cart.Items.Count, Converter={StaticResource NonZeroToVisibilityConverter}}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Cart.Subtotal, StringFormat='{}{0:C}'}" 
                           HorizontalAlignment="Right" MinWidth="80" TextAlignment="Right"
                           Visibility="{Binding Cart.Items.Count, Converter={StaticResource NonZeroToVisibilityConverter}}"/>

                <!-- Delivery Fee -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Delivery Fee:" HorizontalAlignment="Right"
                           Visibility="{Binding Cart.Items.Count, Converter={StaticResource NonZeroToVisibilityConverter}}"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Cart.DeliveryFee, StringFormat='{}{0:C}'}" 
                           HorizontalAlignment="Right" MinWidth="80" TextAlignment="Right"
                           Visibility="{Binding Cart.Items.Count, Converter={StaticResource NonZeroToVisibilityConverter}}"/>

                <!-- Discount -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Discount:" HorizontalAlignment="Right"
                           Visibility="{Binding Cart.Discount, Converter={StaticResource NonZeroDecimalToVisibilityConverter}}"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Cart.Discount, StringFormat='-{0:C}'}" 
                           HorizontalAlignment="Right" MinWidth="80" TextAlignment="Right" Foreground="Green"
                           Visibility="{Binding Cart.Discount, Converter={StaticResource NonZeroDecimalToVisibilityConverter}}"/>

                <!-- Total -->
                <Border Grid.Row="4" Grid.ColumnSpan="2" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Margin="0,10"
                        Visibility="{Binding Cart.Items.Count, Converter={StaticResource NonZeroToVisibilityConverter}}">
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Total:" FontWeight="Bold" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="1" Text="{Binding Cart.Total, StringFormat='{}{0:C}'}" 
                                   FontWeight="Bold" HorizontalAlignment="Right" MinWidth="80" TextAlignment="Right"/>
                    </Grid>
                </Border>

                <!-- Action Buttons -->
                <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Clear Cart" Command="{Binding ClearCartCommand}" Padding="10,5" Margin="0,0,10,0"
                            Visibility="{Binding Cart.Items.Count, Converter={StaticResource NonZeroToVisibilityConverter}}"/>
                    <Button Content="Checkout" Command="{Binding CheckoutCommand}" Padding="20,5" 
                            Background="#4CAF50" Foreground="White"
                            Visibility="{Binding Cart.Items.Count, Converter={StaticResource NonZeroToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>