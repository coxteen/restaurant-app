<UserControl x:Class="RestaurantApp.Views.CartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="#2A2A2A">

    <UserControl.Resources>
        <!-- Modern Button Style (copied from MainWindow) -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#4A4A4A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5A5A5A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cart Button Style (copied from MainWindow) -->
        <Style x:Key="CartButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#C84B31"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D85B41"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#B83B21"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Auth Button Style (green buttons - modified for checkout) -->
        <Style x:Key="CheckoutButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#2E8B57"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3E9B67"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1E7B47"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListView Style -->
        <Style x:Key="ModernListViewStyle" TargetType="ListView">
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <!-- ListView Item Style -->
        <Style x:Key="ModernListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,2"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4A4A4A"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#505050"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Text Style -->
        <Style x:Key="LightTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EEEEEE"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#191919" Padding="15,10">
            <TextBlock Text="Your Cart" FontSize="24" FontWeight="SemiBold" 
                      Foreground="White" Margin="5"/>
        </Border>

        <!-- Cart Items -->
        <ListView Grid.Row="1" ItemsSource="{Binding Cart.Items}" Margin="10"
                 Style="{StaticResource ModernListViewStyle}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Product" DisplayMemberBinding="{Binding ProductName}" Width="200"/>
                    <GridViewColumn Header="Unit Price" DisplayMemberBinding="{Binding UnitPrice, StringFormat='{}{0:C}'}" Width="100"/>
                    <GridViewColumn Header="Quantity" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="-" Width="30" Height="24"
                                            Command="{Binding DataContext.UpdateQuantityCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding ProductId, Converter={StaticResource ProductQuantityConverter}, ConverterParameter=-1}"
                                            Style="{StaticResource ModernButtonStyle}" Padding="5,2"/>
                                    <TextBlock Text="{Binding Quantity}" Width="30" TextAlignment="Center" 
                                              VerticalAlignment="Center" Foreground="White"/>
                                    <Button Content="+" Width="30" Height="24"
                                            Command="{Binding DataContext.UpdateQuantityCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding ProductId, Converter={StaticResource ProductQuantityConverter}, ConverterParameter=1}"
                                            Style="{StaticResource ModernButtonStyle}" Padding="5,2"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Total" DisplayMemberBinding="{Binding TotalPrice, StringFormat='{}{0:C}'}" Width="100"/>
                    <GridViewColumn Header="Actions" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Remove" 
                                        Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                        CommandParameter="{Binding ProductId}"
                                        Style="{StaticResource CartButtonStyle}" Padding="8,3"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource ModernListViewItemStyle}"/>
            </ListView.ItemContainerStyle>
        </ListView>

        <!-- Summary and Checkout -->
        <Border Grid.Row="2" Background="#191919" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Message -->
                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{Binding Message}" 
                           Foreground="#4CAF50" Margin="0,0,0,10"
                           Visibility="{Binding Message, Converter={StaticResource StringToVisibilityConverter}}"/>

                <!-- Cart Empty Message -->
                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Your cart is empty" 
                           FontSize="16" HorizontalAlignment="Center" Margin="0,20"
                           Foreground="White"
                           Visibility="{Binding Cart.Items.Count, Converter={StaticResource ZeroToVisibilityConverter}}"/>

                <!-- Subtotal -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Subtotal:" HorizontalAlignment="Right"
                           Foreground="#CCCCCC"
                           Visibility="{Binding Cart.Items.Count, Converter={StaticResource NonZeroToVisibilityConverter}}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Cart.Subtotal, StringFormat='{}{0:C}'}" 
                           HorizontalAlignment="Right" MinWidth="80" TextAlignment="Right"
                           Foreground="White"
                           Visibility="{Binding Cart.Items.Count, Converter={StaticResource NonZeroToVisibilityConverter}}"/>

                <!-- Delivery Fee -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Delivery Fee:" HorizontalAlignment="Right"
                           Foreground="#CCCCCC"
                           Visibility="{Binding Cart.Items.Count, Converter={StaticResource NonZeroToVisibilityConverter}}"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Cart.DeliveryFee, StringFormat='{}{0:C}'}" 
                           HorizontalAlignment="Right" MinWidth="80" TextAlignment="Right"
                           Foreground="White"
                           Visibility="{Binding Cart.Items.Count, Converter={StaticResource NonZeroToVisibilityConverter}}"/>

                <!-- Discount -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Discount:" HorizontalAlignment="Right"
                           Foreground="#CCCCCC"
                           Visibility="{Binding Cart.Discount, Converter={StaticResource NonZeroDecimalToVisibilityConverter}}"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Cart.Discount, StringFormat='-{0:C}'}" 
                           HorizontalAlignment="Right" MinWidth="80" TextAlignment="Right" Foreground="#4CAF50"
                           Visibility="{Binding Cart.Discount, Converter={StaticResource NonZeroDecimalToVisibilityConverter}}"/>

                <!-- Total -->
                <Border Grid.Row="4" Grid.ColumnSpan="2" BorderBrush="#4A4A4A" BorderThickness="0,1,0,0" Margin="0,10"
                        Visibility="{Binding Cart.Items.Count, Converter={StaticResource NonZeroToVisibilityConverter}}">
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Total:" FontWeight="Bold" HorizontalAlignment="Right" 
                                  Foreground="#EEEEEE"/>
                        <TextBlock Grid.Column="1" Text="{Binding Cart.Total, StringFormat='{}{0:C}'}" 
                                   FontWeight="Bold" HorizontalAlignment="Right" MinWidth="80" TextAlignment="Right"
                                   Foreground="White"/>
                    </Grid>
                </Border>

                <!-- Action Buttons -->
                <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="Clear Cart" Command="{Binding ClearCartCommand}" Padding="10,5" Margin="0,0,10,0"
                            Style="{StaticResource ModernButtonStyle}"
                            Visibility="{Binding Cart.Items.Count, Converter={StaticResource NonZeroToVisibilityConverter}}"/>
                    <Button Content="Checkout" Command="{Binding CheckoutCommand}" Padding="20,5" 
                            Style="{StaticResource CheckoutButtonStyle}"
                            Visibility="{Binding Cart.Items.Count, Converter={StaticResource NonZeroToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>