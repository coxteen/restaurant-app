<UserControl x:Class="RestaurantApp.Views.ProductView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="#2A2A2A">

    <UserControl.Resources>
        <!-- Modern Button Style (based on app-level overlay style) -->
        <Style x:Key="ModernButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseOverlayButtonStyle}">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#4A4A4A"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="AddToCartButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#C84B31"/>
        </Style>

        <Style x:Key="RefreshButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#2E8B57"/>
        </Style>

        <!-- ListView Style -->
        <Style x:Key="ModernListViewStyle" TargetType="ListView">
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>

        <!-- ListView Item Style -->
        <Style x:Key="ModernListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                        <Border x:Name="Border" 
                                Padding="5" 
                                SnapsToDevicePixels="true"
                                Background="{TemplateBinding Background}">
                            <GridViewRowPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4A4A4A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#2E8B57"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with shadow effect -->
        <Border Grid.Row="0" Background="#191919" Padding="15,12" CornerRadius="5" Margin="0,0,0,10">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="1" Opacity="0.3" BlurRadius="5"/>
            </Border.Effect>
            <DockPanel>
                <Button DockPanel.Dock="Right" 
                        Content="Refresh" 
                        Command="{Binding RefreshCommand}" 
                        Style="{StaticResource RefreshButtonStyle}"/>
                <TextBlock Text="Products" 
                           FontSize="24" 
                           FontWeight="SemiBold" 
                           Foreground="White" 
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Products List with shadow effect -->
        <Border Grid.Row="1" Background="#3A3A3A" CornerRadius="5" Margin="0,5">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="1" Opacity="0.3" BlurRadius="5"/>
            </Border.Effect>
            <ListView ItemsSource="{Binding Products}" 
                      SelectedItem="{Binding SelectedProduct}" 
                      Style="{StaticResource ModernListViewStyle}"
                      ItemContainerStyle="{StaticResource ModernListViewItemStyle}"
                      Margin="5">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="150"/>
                        <GridViewColumn Header="Price" DisplayMemberBinding="{Binding Price, StringFormat='{}{0:C}'}" Width="70"/>
                        <GridViewColumn Header="Portion" DisplayMemberBinding="{Binding PortionSize, StringFormat='{}{0}g'}" Width="70"/>
                        <GridViewColumn Header="Category" DisplayMemberBinding="{Binding CategoryName}" Width="100"/>
                        <GridViewColumn Header="Available" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsAvailable}" 
                                              IsEnabled="False" 
                                              HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Allergens" Width="200">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding Allergens}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#2D4263" Margin="2" Padding="3,1" CornerRadius="3">
                                                    <TextBlock Text="{Binding Name}" FontSize="10" Foreground="White"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Actions" Width="130">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Add to Cart" 
                                            Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource AddToCartButtonStyle}"
                                            Padding="10,3"
                                            Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- Message with updated style -->
        <Border Grid.Row="2" Background="#2A2A2A" CornerRadius="5" Margin="0,10,0,0" Padding="10"
                Visibility="{Binding Message, Converter={StaticResource StringToVisibilityConverter}}">
            <TextBlock Text="{Binding Message}" 
                       Foreground="#2E8B57"/>
        </Border>
    </Grid>
</UserControl>