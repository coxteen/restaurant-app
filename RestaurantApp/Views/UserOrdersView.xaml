<UserControl x:Class="RestaurantApp.Views.UserOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="#2A2A2A">

    <UserControl.Resources>
        <!-- Modern Button Style (copied from MainWindow) -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#4A4A4A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5A5A5A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListView Style -->
        <Style x:Key="ModernListViewStyle" TargetType="ListView">
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>

        <!-- ListView Item Style -->
        <Style x:Key="ModernListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                        <Border x:Name="Border" 
                                Padding="5" 
                                SnapsToDevicePixels="true"
                                Background="{TemplateBinding Background}">
                            <GridViewRowPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4A4A4A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#2E8B57"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Expander Style -->
        <Style x:Key="ModernExpanderStyle" TargetType="Expander">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Cancel Button Style (similar to Cart button style from MainWindow) -->
        <Style x:Key="CancelButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#C84B31"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D85B41"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#B83B21"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Refresh Button Style (similar to Auth style from MainWindow) -->
        <Style x:Key="RefreshButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#2E8B57"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3E9B67"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1E7B47"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with shadow effect similar to MainWindow -->
        <Border Grid.Row="0" Background="#191919" Padding="15,12" CornerRadius="5" Margin="0,0,0,10">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="1" Opacity="0.3" BlurRadius="5"/>
            </Border.Effect>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Refresh" 
                        Command="{Binding RefreshCommand}" 
                        Style="{StaticResource RefreshButtonStyle}"/>
                <TextBlock Text="My Orders" FontSize="24" FontWeight="SemiBold" 
                           Foreground="White" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Orders List with shadow effect -->
        <Border Grid.Row="1" Background="#3A3A3A" CornerRadius="5" Margin="0,5">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="1" Opacity="0.3" BlurRadius="5"/>
            </Border.Effect>
            <ListView ItemsSource="{Binding Orders}" 
                      SelectedItem="{Binding SelectedOrder}" 
                      Style="{StaticResource ModernListViewStyle}"
                      ItemContainerStyle="{StaticResource ModernListViewItemStyle}"
                      Margin="5">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Order ID" DisplayMemberBinding="{Binding OrderId}" Width="70"/>
                        <GridViewColumn Header="Date" DisplayMemberBinding="{Binding OrderDate, StringFormat='{}{0:g}'}" Width="150"/>
                        <GridViewColumn Header="Total" DisplayMemberBinding="{Binding TotalAmount, StringFormat='{}{0:C}'}" Width="80"/>
                        <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="100"/>
                        <GridViewColumn Header="Est. Delivery" DisplayMemberBinding="{Binding EstimatedDeliveryTime, StringFormat='{}{0:g}'}" Width="150"/>
                        <GridViewColumn Header="Actions" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Cancel" 
                                            Command="{Binding DataContext.CancelOrderCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource CancelButtonStyle}"
                                            Visibility="{Binding Status, Converter={StaticResource StringToOrderStatusConverter}}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- Order Details with shadow effect -->
        <Border Grid.Row="2" Background="#2A2A2A" CornerRadius="5" Margin="0,10,0,0">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="1" Opacity="0.3" BlurRadius="5"/>
            </Border.Effect>
            <Expander Header="Order Details" 
                      Style="{StaticResource ModernExpanderStyle}"
                      IsExpanded="True"
                      Padding="10">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Message -->
                    <TextBlock Grid.Row="0" Text="{Binding Message}" 
                               Foreground="#2E8B57" Margin="0,0,0,10"
                               Visibility="{Binding Message, Converter={StaticResource StringToVisibilityConverter}}"/>

                    <!-- Order Items -->
                    <ListView Grid.Row="1" 
                              ItemsSource="{Binding SelectedOrder.OrderItems}" 
                              Style="{StaticResource ModernListViewStyle}"
                              ItemContainerStyle="{StaticResource ModernListViewItemStyle}"
                              MaxHeight="200">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Product" DisplayMemberBinding="{Binding ProductName}" Width="200"/>
                                <GridViewColumn Header="Unit Price" DisplayMemberBinding="{Binding UnitPrice, StringFormat='{}{0:C}'}" Width="100"/>
                                <GridViewColumn Header="Quantity" DisplayMemberBinding="{Binding Quantity}" Width="70"/>
                                <GridViewColumn Header="Total" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Foreground="White">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource OrderItemTotalMultiConverter}">
                                                        <Binding Path="Quantity" />
                                                        <Binding Path="UnitPrice" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Expander>
        </Border>
    </Grid>
</UserControl>