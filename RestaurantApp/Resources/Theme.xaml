<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Palette -->
  <SolidColorBrush x:Key="WindowBackground" Color="#3A3A3A" />
  <SolidColorBrush x:Key="PanelBackground" Color="#2A2A2A" />
  <SolidColorBrush x:Key="PrimaryBrush" Color="#4A4A4A" />
  <SolidColorBrush x:Key="AccentBrush" Color="#C84B31" />
  <SolidColorBrush x:Key="AccentBrushHover" Color="#D85B41" />
  <SolidColorBrush x:Key="PrimaryForeground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="SecondaryForeground" Color="#CCCCCC" />

  <!-- Typography -->
  <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>

  <!-- Common values -->
  <CornerRadius x:Key="DefaultCornerRadius">6</CornerRadius>

  <!-- Subtle hover overlays -->
  <SolidColorBrush x:Key="HoverOverlayBrush" Color="#22000000" /> <!-- ~13% black -->
  <SolidColorBrush x:Key="PressedOverlayBrush" Color="#33000000" /> <!-- ~20% black -->
  <!-- Base overlay button style (keyed) -->
  <Style x:Key="BaseOverlayButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryForeground}" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Margin" Value="4" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="RootBorder" Background="{TemplateBinding Background}" CornerRadius="{StaticResource DefaultCornerRadius}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.6" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Window style applied implicitly -->
  <Style TargetType="Window">
    <Setter Property="Background" Value="{StaticResource WindowBackground}" />
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryForeground}" />
  </Style>
  <!-- Button default style (implicit) uses base overlay style -->
  <Style TargetType="Button" BasedOn="{StaticResource BaseOverlayButtonStyle}" />

  <!-- Subtle ListViewItem template for hover/selection to avoid abrupt background changes -->
  <Style TargetType="ListViewItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="Margin" Value="2,2,2,2" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListViewItem">
          <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="4">
            <Grid>
              <Rectangle x:Name="ItemHoverOverlay" Fill="{StaticResource HoverOverlayBrush}" Visibility="Collapsed" RadiusX="4" RadiusY="4" />
              <ContentPresenter />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ItemHoverOverlay" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="ItemBorder" Property="Background" Value="#2E8B57" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- TextBox default style -->
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="White" />
    <Setter Property="Foreground" Value="Black" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="Margin" Value="4" />
    <Setter Property="BorderBrush" Value="#888888" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- TextBlock default -->
  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource PrimaryForeground}" />
  </Style>

  <!-- ListView default -->
  <Style TargetType="ListView">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Margin" Value="4" />
  </Style>

  <!-- GridView column header style to ensure readability on dark theme -->
  <Style TargetType="GridViewColumnHeader">
    <Setter Property="Background" Value="#3A3A3A" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryForeground}" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>

</ResourceDictionary>
